diff --git a/packages/components/playground/src/playground.css b/packages/components/playground/src/playground.css
new file mode 100644
index 0000000..54be338
--- /dev/null
+++ b/packages/components/playground/src/playground.css
@@ -0,0 +1,56 @@
+.playground {
+  max-width: 640px;
+  margin: 0 auto;
+  padding: 2rem;
+  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
+}
+
+.playground__heading {
+  margin-bottom: 0.25rem;
+  font-size: 1.5rem;
+  font-weight: 700;
+}
+
+.playground__subtitle {
+  color: #6b7280;
+  font-size: 0.875rem;
+  margin-bottom: 2rem;
+}
+
+.playground-section {
+  margin-bottom: 2rem;
+}
+
+.playground-section__title {
+  font-size: 1.125rem;
+  font-weight: 600;
+  border-bottom: 1px solid #e5e7eb;
+  padding-bottom: 0.5rem;
+  margin: 0 0 0.75rem;
+}
+
+.playground-section__body {
+  display: flex;
+  flex-direction: column;
+  gap: 0.75rem;
+}
+
+.playground-row {
+  background: #f9fafb;
+  border: 1px solid #e5e7eb;
+  border-radius: 0.375rem;
+  padding: 0.75rem 1rem;
+}
+
+.playground-row__label {
+  display: block;
+  font-size: 0.75rem;
+  color: #6b7280;
+  font-family: "SF Mono", "Fira Code", "Fira Mono", Menlo, Consolas, monospace;
+  margin-bottom: 0.375rem;
+  line-height: 1.4;
+}
+
+.playground-row__content {
+  line-height: 1.6;
+}
