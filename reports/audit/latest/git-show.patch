-+    const value = match[1];
-+    const offset = match.index ?? -1;
-+
-+    if (offset < 0) {
-+      continue;
-+    }
-+
-+    if (isHeadingMarker(markdown, offset)) {
-+      continue;
-+    }
-+
-+    if (isOffsetProtected(protectedRegions, offset)) {
-+      continue;
-+    }
-+
-+    if (isInRanges(offset, highlightRanges)) {
-+      continue;
-+    }
-+
-+    tags.push({
-+      index: tags.length,
