+export function Highlight({ text, color }: HighlightProps) {
+  const style = getHighlightStyle({ text, color });
+
+  return (
+    <mark
+      className="nabla-highlight"
+      data-has-color={color ? "" : undefined}
+      style={
+        color
+          ? { backgroundColor: color, color: "#1a1a1a" }
+          : undefined
+      }
+    >
+      {style.text}
+    </mark>
+  );
+}
