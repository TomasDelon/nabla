-+  let path = input.trim();
-+
-+  path = path.normalize("NFC");
-+
-+  path = path.replace(/\\/g, "/");
-+
-+  path = path.replace(/\/+/g, "/");
-+
-+  path = path.replace(/^\.\//, "");
-+
-+  const lower = path.toLowerCase();
-+  if (path.endsWith(".md") || path.endsWith(".mp")) {
-+    const stripped = path.slice(0, -3);
-+    if (stripped.length > 0) {
-+      return stripped;
-+    }
-+  }
-+
-+  return path;
-+}
