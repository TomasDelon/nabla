{
  "name": "@nabla/components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/tokens.css": "./src/tokens.css",
    "./src/task-state.css": "./src/task-state.css",
    "./src/wiki-link.css": "./src/wiki-link.css",
    "./src/tag.css": "./src/tag.css",
    "./src/highlight.css": "./src/highlight.css",
    "./src/emoji.css": "./src/emoji.css",
    "./src/footnote.css": "./src/footnote.css",
    "./src/comment.css": "./src/comment.css",
    "./src/callout.css": "./src/callout.css",
    "./src/toggle.css": "./src/toggle.css",
    "./src/folded-heading.css": "./src/folded-heading.css"
  },
  "files": [
    "dist",
    "src/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "vite --host 127.0.0.1 playground"
  },
  "dependencies": {
    "@nabla/markup": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^5.4.0"
  }
}
